# ============================================
#  Flask Inventory Management System - Environment Variables
#  Copy this file to .env and adjust the values
# ============================================

# Flask secret key (change this in production!)
SECRET_KEY=change-me-in-production

# Debug mode (set to False in production)
DEBUG=True

# Development server port
PORT=5000

# Comma separated list of allowed hosts (leave blank to allow all)
ALLOWED_HOSTS=localhost,127.0.0.1

# Database URL (defaults to flask_app/inventory.db when not set)
# DATABASE_URL=sqlite:///C:/path/to/inventory.db
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/inventory

# Low stock alert threshold
LOW_STOCK_THRESHOLD=10
