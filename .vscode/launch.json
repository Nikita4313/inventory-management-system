            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Django: Shell",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/manage.py",
            "args": [
                "shell"
            ],
            "cwd": "${workspaceFolder}",
            "env": {
                "DJANGO_SETTINGS_MODULE": "inventory_system.settings"
            },
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Django: Check",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/manage.py",
            "args": [
