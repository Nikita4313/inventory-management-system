# ============================================
#  Inventory Management System - Environment Variables
#  Copy this file to .env and fill in values
# ============================================

# Flask secret key (change in production!)
SECRET_KEY=your-secret-key-here-change-in-production

# Flask environment (development, production, testing)
FLASK_ENV=development

# Debug mode (set to False in production)
DEBUG=True

# Flask host and port
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# Database URL (SQLAlchemy)
# SQLite: sqlite:///inventory.db
# PostgreSQL: postgresql://username:password@localhost/dbname
# MySQL: mysql+pymysql://username:password@localhost/dbname
DATABASE_URL=sqlite:///inventory.db

